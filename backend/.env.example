HOST=127.0.0.1
PORT=8000
DATABASE_URL=postgresql://village:village@127.0.0.1:5432/village?sslmode=disable
CORS_ORIGINS=["http://localhost:4001","http://localhost:3000"]

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
GAME_GUIDE_MODEL=gpt-5.4-nano
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_CLOUD_URL=https://ollama.com

# Required to open the operator-only /history page in a deployed app.
GAME_HISTORY_ACCESS_KEY=
